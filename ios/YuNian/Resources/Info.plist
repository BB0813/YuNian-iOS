<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>予念</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- 中文为默认语言；其余语言由 String Catalog 提供（M4 接入，见文档 §4.5） -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
		<string>ja</string>
		<string>ko</string>
		<string>zh-Hant</string>
	</array>

	<!-- 仅声明竖屏：与 Android 侧的手机端体验一致 -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!--
	  启动屏。**必须有**：project.yml 未声明 TARGETED_DEVICE_FAMILY（XcodeGen 默认
	  iPhone + iPad），而缺 UILaunchScreen 时 iPad 上会被信箱化运行（iPhone 尺寸窗口），
	  且现代 Xcode 会就此告警。空 dict 即为 Xcode 模板的默认形态。
	-->
	<key>UILaunchScreen</key>
	<dict/>

	<!--
	  注意：这里**刻意不声明** UIBackgroundModes 与 aps-environment。
	  原因见 docs/ios-port-feasibility.md §3.2 与 §5.1：
	    · 免费 Apple ID 无法启用 Push Notifications capability；
	    · iOS 没有 Android 的精确闹钟/FGS 保活模型，「主动找你」的调度必须上移到服务端。
	  在服务端方案（M5）与付费账号就位之前打开这两项会导致签名失败或审核问题。
	-->

	<key>NSFaceIDUsageDescription</key>
	<string>用于保护本地会话密钥（可选功能）。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于发送语音消息与语音通话。</string>
	<key>NSCameraUsageDescription</key>
	<string>用于拍摄并发送图片。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于选择并发送图片、导入表情包。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>用于把收到的图片保存到相册。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>用于语音转文字。</string>
</dict>
</plist>
