<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- SuFlowAPI Key Server: allow cleartext for local deployment -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">156.233.228.31</domain>
    </domain-config>

    <!-- Debug overrides: allow system certificates for development -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
